# Copier ce fichier en .env pour le développement local. Ne jamais versionner .env.

NODE_ENV=development
PORT=3000

# Laisser vide en local : une base PGlite est créée dans .data/ (rien à installer).
# Obligatoire en production (Railway la fournit via le service PostgreSQL).
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/taxi_crm
PGLITE_DATA_DIR=.data/pglite

# Crée le compte gérant au premier démarrage (identifiant : « gerant »). 12 caractères minimum.
# Sans effet ensuite : à retirer une fois le mot de passe changé dans l'application.
ADMIN_INITIAL_PASSWORD=
